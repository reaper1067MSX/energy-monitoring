<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>VoltTray</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VoltTray.Core\VoltTray.Core.csproj" />
    <ProjectReference Include="..\VoltTray.Infrastructure\VoltTray.Infrastructure.csproj" />
    <ProjectReference Include="..\VoltTray.UI\VoltTray.UI.csproj" />
  </ItemGroup>
</Project>
