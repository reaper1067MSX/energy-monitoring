<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>VoltTray.UI</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoltTray.Core\VoltTray.Core.csproj" />
    <ProjectReference Include="..\VoltTray.Shared\VoltTray.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp" Version="4.158.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.4" />
  </ItemGroup>

</Project>
